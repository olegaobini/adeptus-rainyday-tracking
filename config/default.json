
{

  "version": "1.1",
  "description": "Base configuration for Boeing sensor tracking simulation",

  "scenario": {
    "mode": "3D",
    "num_targets": 2,
    "duration_s": 5
  },

  "radar": {
    "type": "fusionRadarSensor",
    "rpm": 25,
    "fov_azimuth": 1.5,
    "fov_elevation": 10,
    "azimuth_limits": [250, 290],
    "elevation_tilt": 2,
    "reference_range": 111000,
    "reference_rcs": 0,
    "range_resolution": 135,
    "detection_probability": 0.8,
    "false_alarm_rate": 1e-6,
    "mounting_location": [0, 0, -15]
  },

  "degradation": {
    "enabled": false,
    "type": "rain",
    "description": "Weather/environmental degradation mode"
  },

  "environment": {
    "terrain_occlusion": false,
    "horizon_masking": false,
    "refraction_factor": 1.333,
    "ground_clutter": false,
    "propagation_model": false,
    "terrain_type": "water",
    "clutter_density": 0.5,
    "_terrain_options": "water | rural | urban | mountain",
    "_description": "Horizon masking uses 4/3 Earth radius model. Ground clutter generates terrain-dependent false returns at low elevation. Propagation model uses radarvcd to compute vertical coverage patterns accounting for multipath ground-bounce lobing."
  },

  "data_logging": {
    "use_saved_datalog": false,
    "datalog_file": "cache/myRun1.mat",
    "save_after_generation": true
  },

  "tracker_global": {
    "max_num_tracks": 500,
    "volume": 1e9,
    "beta": 1e-14,
    "detection_probability": {
        "ideal": 0.9,
        "degraded": 0.7
    }
  },

  "tracker_params": {
    "ideal": {
      "gate": 45,
      "far_gnn": 1e-6,
      "far_mht": 1e-6,
      "far_jpda": 1e-6,
      "confirm_threshold": 20,
      "delete_threshold": -5,
      "tomht_threshold_multiplier": [0.2, 1, 1],
      "max_branches": 5,
      "beta_jpda": 1e-14,
      "gate_jpda": 45,
      "time_tolerance_jpda": 0.05,
      "num_tracks_jpda": 500
    },

    "degraded": {
      "gate": 80,
      "far_gnn": 1e-2,
      "far_mht": 1e-3,
      "far_jpda": 1e-3,
      "confirm_threshold": 15,
      "delete_threshold": -7,
      "tomht_threshold_multiplier": [0.2, 5, 5],
      "max_branches": 3,
      "beta_jpda": 1e-11,
      "gate_jpda": 80,
      "time_tolerance_jpda": 0.05,
      "num_tracks_jpda": 200
    }
  },

  "filter_params": {
    "init_speed_kmh": 900,
    "imm_transition_prob": 0.97,
    "scale_accel_horz": 30,
    "scale_omega_dot": 30
  },
  
  "trackers_to_run": {
    "gnn_cv":    true,
    "gnn_imm":   false,
    "tomht_cv":  false,
    "tomht_imm": false,
    "jpda_cv":   false,
    "jpda_imm":  false
  },

  "scenarios_to_run": {
    "_comment": "Toggle true/false. Run all enabled scenarios with: runAllScenarios()",
    "dasr_ideal":              false,
    "dasr_degraded":           false,
    "crossing_targets":        false,
    "head_on":                 false,
    "high_density":            true,
    "maneuvering_evasive":     false,
    "storm_window":            false,
    "long_range_arsr":         false,
    "approach_pattern":        false,
    "par_approach":            false,
    "phased_array_intercept":  false,
    "ir_radar_fusion":         false,
    "ir_degraded_weather":     false,
    "maritime_surface":        false,
    "fighter_intercept":       false,
    "fire_control_engagement": false,
    "layered_defense":         false,
    "layered_defense_storm":   false
  },
  
  "output": {
    "print_diagnostics": true,
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "save_figures": true,
    "results_directory": "results"
  }

}
