{
  "version": "2.0",
  "description": "Canonical default config for trackbench pipeline",
  "scenario": {
    "mode": "3D",
    "frame": "NED",
    "num_targets": 2,
    "duration_s": 20
  },
  "sensors": {
    "ref": "sensors"
  },
  "truth": {
    "targets": [
      {
        "name": "crossing_pair",
        "path": "data/truths/crossing_pair.csv"
      }
    ]
  },
  "weather": {
    "ref": "clear"
  },
  "degradation": {
    "enabled": false,
    "type": "rain"
  },
  "environment": {
    "terrain_occlusion": false,
    "horizon_masking": false,
    "refraction_factor": 1.333,
    "ground_clutter": false,
    "propagation_model": false,
    "terrain_type": "water",
    "clutter_density": 0.5
  },
  "data_logging": {
    "use_saved_datalog": false,
    "datalog_file": "cache/myRun1.mat",
    "save_after_generation": true
  },
  "trackers": {
    "global": {
      "max_num_tracks": 500,
      "volume": 1000000000,
      "beta": 1e-14,
      "detection_probability": {
        "ideal": 0.9,
        "degraded": 0.7
      }
    },
    "params": {
      "ideal": {
        "gate": 45,
        "far_gnn": 1e-6,
        "far_mht": 1e-6,
        "far_jpda": 1e-6,
        "confirm_threshold": 20,
        "delete_threshold": -5,
        "tomht_threshold_multiplier": [0.2, 1, 1],
        "max_branches": 5,
        "beta_jpda": 1e-14,
        "gate_jpda": 45,
        "time_tolerance_jpda": 0.05,
        "num_tracks_jpda": 500
      },
      "degraded": {
        "gate": 80,
        "far_gnn": 0.01,
        "far_mht": 0.001,
        "far_jpda": 0.001,
        "confirm_threshold": 15,
        "delete_threshold": -7,
        "tomht_threshold_multiplier": [0.2, 5, 5],
        "max_branches": 3,
        "beta_jpda": 1e-11,
        "gate_jpda": 80,
        "time_tolerance_jpda": 0.05,
        "num_tracks_jpda": 200
      }
    },
    "run": {
      "gnn_cv": true,
      "gnn_imm": false,
      "tomht_cv": false,
      "tomht_imm": false,
      "jpda_cv": false,
      "jpda_imm": false
    }
  },
  "filter_params": {
    "init_speed_kmh": 900,
    "imm_transition_prob": 0.97,
    "scale_accel_horz": 30,
    "scale_omega_dot": 30
  },
  "output": {
    "print_diagnostics": true,
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "save_figures": false,
    "results_directory": "outputs"
  }
}
