{
  "description": "PSR + IRST in rain — radar degrades but IR unaffected, shows fusion benefit",
  "sensors": [
    "PSR/default_PSR",
    "IRST/default_IRST"
  ],
  "targets": "ir_degraded_weather/default_ir_degraded_weather",
  "terrain": "rural/default_rural",
  "trackers": [
      "GNN/default_GNN",
      "JPDA/default_JPDA"
    ],
  "degradation": {
    "enabled": true,
    "type": "rain"
  },
  "platforms": {},
  "cache": {
    "use_cached_detections": true,
    "save_detections": true
  },
  "output": {
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "print_diagnostics": true,
    "results_directory": "results"
  }
}