{
  "description": "Search radar + fire control radar — handoff from search to track",
  "sensors": [
    "PSR/default_PSR",
    "FIRE_CONTROL/default_FIRE_CONTROL"
  ],
  "targets": "fire_control_engagement/default_fire_control_engagement",
  "terrain": "rural/default_rural",
  "trackers": [
      "GNN/default_GNN",
      "JPDA/default_JPDA"
    ],
  "degradation": {
    "enabled": false,
    "type": "rain"
  },
  "platforms": {},
  "cache": {
    "use_cached_detections": true,
    "save_detections": true
  },
  "output": {
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "print_diagnostics": true,
    "results_directory": "results"
  }
}