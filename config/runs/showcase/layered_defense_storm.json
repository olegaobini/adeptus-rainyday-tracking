{
  "description": "Full layered defense in heavy rain — shows which sensors degrade and which don't",
  "sensors": [
    "PSR/default_PSR",
    "IRST/default_IRST",
    "FIRE_CONTROL/default_FIRE_CONTROL",
    "TWS/default_TWS"
  ],
  "targets": "layered_defense_storm/default_layered_defense_storm",
  "terrain": "rural/default_rural",
  "trackers": [
      "GNN/default_GNN",
      "JPDA/default_JPDA"
    ],
  "degradation": {
    "enabled": true,
    "type": "heavy_rain"
  },
  "platforms": {},
  "cache": {
    "use_cached_detections": true,
    "save_detections": true
  },
  "output": {
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "print_diagnostics": true,
    "results_directory": "results"
  }
}