{
  "description": "TWS ground array + AESA airborne fighter — phased array sensor fusion",
  "sensors": [
    "TWS/default_TWS",
    "AESA/default_AESA"
  ],
  "targets": "phased_array_intercept/default_phased_array_intercept",
  "terrain": "rural/default_rural",
  "trackers": [
      "GNN/default_GNN",
      "JPDA/default_JPDA"
    ],
  "degradation": {
    "enabled": false,
    "type": "rain"
  },
  "platforms": {
    "aircraft": {
      "start_pos": [
        0,
        -50000,
        -8000
      ],
      "heading_deg": 180,
      "speed_kmh": 900,
      "x_note": "Fighter at 8km alt, flying south (-Y) toward targets"
    }
  },
  "cache": {
    "use_cached_detections": true,
    "save_detections": true
  },
  "output": {
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "print_diagnostics": true,
    "results_directory": "results"
  }
}