{
    "description": "DEMO 2: Multi-target NASA flight — RURAL terrain. Adds horizon masking, ground clutter, terrain occlusion.",
    "sensors": ["PSR/default_PSR"],
    "targets": "recorded_flight/nasa_multi_target",
