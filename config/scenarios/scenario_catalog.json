    "fighter_intercept": {
      "description": "AESA + FLIR airborne — fighter tracking bogey, sensor fusion at range",
      "sensor_config": "sensors_fighter",
      "overrides": {
        "scenario.duration_s": 60,
        "scenario.num_targets": 2,
        "degradation.enabled": false,
        "data_logging.use_saved_datalog": false,
