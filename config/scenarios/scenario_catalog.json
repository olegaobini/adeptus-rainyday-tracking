        "scenario.duration_s": 60,
        "scenario.num_targets": 3,
        "degradation.enabled": false,
        "data_logging.use_saved_datalog": false,
        "data_logging.datalog_file": "cache/phased_array.mat",
        "tracker_params.ideal.gate": 50
      },
      "platforms": {
        "aircraft": {
          "start_pos": [0, -50000, -8000],
          "heading_deg": 180,
          "speed_kmh": 900,
          "_note": "Fighter at 8km alt, flying south (-Y) toward targets"
        }
      },
      "targets": [
        {
          "behavior": "constant_velocity",
          "speed_kmh": 1200,
          "start_pos": [-80000, -150000, -8000],
          "heading_deg": 60,
          "altitude_m": 8000,
          "_note": "Fast inbound — fighter-type speed"
        },
        {
          "behavior": "s_maneuver",
          "speed_kmh": 1000,
          "start_pos": [50000, -120000, -10000],
          "turn_rate_dps": 4,
          "altitude_m": 10000,
          "_note": "Maneuvering target — tests phased array update rate advantage"
        },
        {
          "behavior": "constant_velocity",
          "speed_kmh": 900,
          "start_pos": [0, -180000, -12000],
          "heading_deg": 0,
          "altitude_m": 12000,
          "_note": "High-altitude cruise"
        }
      ]
    },

