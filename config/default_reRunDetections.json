{
  "version": "1.0",
  "description": "DASR (ASR-11) configuration - PSR 60nm + MSSR 120nm",
  "scenario": {
    "mode": "3D",
    "num_targets": 2,
    "duration_s": 50,
    "num_sensors": 1,
    "iff": {
      "enabled": true,
      "update_rate_hz": 12.5,
      "range_sigma_m": 100,
      "az_sigma_deg": 0.1,
      "pd": 0.99
    }
  },
  "degradation": {
    "enabled": false
    "type": "rain",
    "description": "Weather/environmental degradation mode"
  },
  "data_logging": {
    "use_saved_datalog": false,
    "datalog_file": "cache/myRun2.mat",
    "save_after_generation": true
  },
  "tracker_global": {
    "max_num_tracks": 500,
    "volume": 1e9,
    "beta": 1e-14,
    "detection_probability": {
      "ideal": 0.9,
      "degraded": 0.7
    }
  },
  "tracker_params": {
    "ideal": {
      "gate": 65,
      "far_gnn": 1e-6,
      "far_mht": 1e-6,
      "far_jpda": 1e-6,
      "confirm_threshold": 20,
      "delete_threshold": -5,
      "tomht_threshold_multiplier": [0.2, 1, 1],
      "max_branches": 5,
      "beta_jpda": 1e-14,
      "gate_jpda": 65,
      "time_tolerance_jpda": 0.05,
      "num_tracks_jpda": 500
    },
    "degraded": {
      "gate": 80,
      "far_gnn": 1e-2,
      "far_mht": 1e-3,
      "far_jpda": 1e-3,
      "confirm_threshold": 15,
      "delete_threshold": -7,
      "tomht_threshold_multiplier": [0.2, 5, 5],
      "max_branches": 3,
      "beta_jpda": 1e-11,
      "gate_jpda": 80,
      "time_tolerance_jpda": 0.05,
      "num_tracks_jpda": 200
    }
  },
  "filter_params": {
    "init_speed_kmh": 900,
    "imm_transition_prob": 0.97,
    "scale_accel_horz": 30,
    "scale_omega_dot": 30
  },
  "trackers_to_run": {
    "gnn_cv": true,
    "gnn_imm": true,
    "tomht_cv": false,
    "tomht_imm": false,
    "jpda_cv": false,
    "jpda_imm": false
  },
  "output": {
    "print_diagnostics": true,
    "show_visuals": true,
    "animate_visuals": true,
    "save_results": true,
    "results_directory": "results"
  }
}
