# MATLAB generated
*.asv
*.mex*
*.mlappinstall
slprj/

# Runtime outputs — don't commit
results/
cache/

# Build outputs — mostly excluded from git (built locally by
# build_executable / build_installer; the 1.5 GB offline installer would be
# rejected by GitHub anyway).
adeptus-rainyday-tracking/trackbench/
adeptus-rainyday-tracking/installer/offline/
*.exe

# EXCEPTION: the ~5 MB web installer is committed to the repo so teammates
# can grab it directly from GitHub and run it without needing access to
# GitHub Releases, OneDrive shares, or anything else. This is the file
# TESTING.md tells them to download.
!adeptus-rainyday-tracking/installer/web/RainyDayTrackerInstaller_web.exe

# Per-user data dir marker (only ever lives in %LOCALAPPDATA%\RainyDay,
# but ignore it everywhere just in case someone copies their user data
# dir into the repo by accident).
.rainyday_userdata

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE / local editor state
.claude/



# NASA DASHlink Tail 687 flight data — 812 MB, publicly re-downloadable.
# Ignore all .mat files in Tail_687_1/ by default, then whitelist only the
# specific flights referenced by demo run configs (nasa_tail687_sample and
# nasa_multi_target) so the demos work out of the box after clone.
# Full dataset source: https://c3.ndc.nasa.gov/dashlink/resources/664/
Tail_687_1/*.mat
!Tail_687_1/687200104121330.mat
!Tail_687_1/687200107261425.mat
!Tail_687_1/687200107282131.mat
