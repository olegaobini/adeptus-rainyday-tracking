{
    "description": "NASA real flight + rain storm — ramps in at t=100s, peaks at t=300s, clears by t=500s",
    "sensors": ["PSR/default_PSR"],
    "targets": "recorded_flight/nasa_tail687_sample",
    "terrain": "rural/default_rural",
    "trackers": ["GNN/default_GNN", "JPDA/default_JPDA"],
    "degradation": {
        "terrain_occlusion": true,
        "horizon_masking": true,
        "ground_clutter": true,
        "doppler_fade": true,
        "weather": "rain/heavy_rain",
        "storm_start_s": 100,
        "storm_end_s": 500,
        "active_type": "ramp"
    },
    "cache": { "use_cached_detections": false, "save_detections": true },
    "platforms": {},
    "output": { "show_visuals": true, "animate_visuals": false, "save_results": true, "globe_view": true }
}
