{
  "description": "M4 end-to-end test: simulator flies a curved editor path.",
  "sensors": [
    "PSR/default_PSR"
  ],
  "targets": "waypoints/m4_curved_demo",
  "terrain": "rural/default_rural",
  "trackers": [
    "GNN/default_GNN"
  ],
  "degradation": {
    "terrain_occlusion": false,
    "horizon_masking": false,
    "ground_clutter": false,
    "doppler_fade": false,
    "weather": "none"
  },
  "cache": {
    "use_cached_detections": false,
    "save_detections": false
  },
  "output": {
    "show_visuals": true,
    "animate_visuals": false,
    "save_results": false
  }
}