{
    "description": "DEMO 5 TUNED: Same tropical storm detections, but with AUTO-TUNED GNN. Shows optimized tracker in worst-case conditions.",
    "sensors": ["PSR/PSR_demo_multi", "SSR/SSR_demo_multi"],
    "targets": "recorded_flight/nasa_multi_target",
    "terrain": "mountain/default_mountain",
    "trackers": ["autotuned/demo_multi_5_tropicalStorm/GNN_IMM"],
    "degradation": {
        "terrain_occlusion": true,
        "horizon_masking": true,
        "ground_clutter": true,
        "doppler_fade": true,
        "weather": "rain/tropicalStorm"
    },
    "cache": { "use_cached_detections": true, "save_detections": true },
    "platforms": {},
    "output": {
        "show_visuals": true,
        "animate_visuals": false,
        "save_results": true,
        "print_diagnostics": true,
        "results_directory": "results"
    }
}
